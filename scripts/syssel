#!/bin/zsh
set -euo pipefail

REPO="/Users/karoaa/Developer/sysselcraft"
EXPECTED_BRANCH="nova/local-construction-snapshot"

fail() { print -u2 "❌ $1"; exit 1; }

cd "$REPO" || fail "Hittar inte SysselCraft-repot: $REPO"
[[ "$(pwd -P)" == "$REPO" ]] || fail "Fel repo: $(pwd -P)"
[[ "$(git branch --show-current)" == "$EXPECTED_BRANCH" ]] || fail "Fel branch: $(git branch --show-current)"

print "🏡 SysselCraft: kontrollerar lokalt läge..."
changes="$(git status --porcelain)"
unsafe="$(print -r -- "$changes" | grep -vE '^ M ios/App/App/config\.xml$' || true)"
[[ -z "$unsafe" ]] || {
  print -u2 "❌ Lokala ändringar finns. Nova-sync avbryts för att skydda dem:"
  print -u2 -r -- "$changes"
  exit 1
}

before="$(git rev-parse --short HEAD)"
print "📍 $EXPECTED_BRANCH @ $before"
if [[ -n "$changes" ]]; then
  print "🛡️  Bevarar känd lokal config.xml-ändring."
fi

print "⬇️  Hämtar senaste Nova-koden..."
git pull --ff-only

print "🔨 Bygger webbappen från ren exportkatalog..."
rm -rf out
npm run build

after="$(git rev-parse --short HEAD)"
marker="sysselcraft-build-$after"
print -r -- "$marker" > out/syssel-build.txt

print "📱 Synkar befintligt iOS-projekt..."
npx cap sync ios

[[ -f ios/App/App/public/syssel-build.txt ]] || fail "Capacitor kopierade inte build-markören till iOS."
copied_marker="$(cat ios/App/App/public/syssel-build.txt)"
[[ "$copied_marker" == "$marker" ]] || fail "iOS innehåller fel webbuild: $copied_marker (väntade $marker)"

# Xcode treats Capacitor's public directory as one folder resource. Force the
# next Run to rebuild/copy that resource instead of reusing an older app bundle.
touch ios/App/App/public
print "🧹 Rensar endast Xcodes build-produkter (installerad app och save lämnas orörda)..."
xcrun xcodebuild -project ios/App/App.xcodeproj -scheme App clean >/dev/null

print "🔎 Verifierad iOS-webbuild: $marker"
print ""
print "✅ SysselCraft är synkad och byggd @ $after"
print "▶️  Öppna ios/App/App.xcodeproj och tryck Run. Appen har inte raderats eller resetats."
